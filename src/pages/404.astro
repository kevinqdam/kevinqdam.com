---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar';
---

<Layout title="Page not found | Kevin Dam">
  <NavBar client:load activePath="/" />
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="eyebrow">Error</p>
    <h1 id="not-found-heading">This page went wandering.</h1>
    <p>
      The page you requested doesn't exist. Status code:
      <span class="status-code">404</span>
    </p>
    <a class="button-primary" href="/">Return home <span aria-hidden="true">→</span></a>
  </section>
</Layout>
