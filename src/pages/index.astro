---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import profileImage from '../assets/images/kevinqdam.png';
---

<Layout
  title="Kevin Dam | Software Engineer"
  description="Kevin Dam is a software engineer. Find his experience, writing, and contact information."
>
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-copy">
      <p class="eyebrow">Software engineer</p>
      <h1 id="home-heading">Kevin Dam<span aria-hidden="true">.</span></h1>
      <div class="hero-actions" aria-label="Contact Kevin Dam">
        <a class="button-primary" href="mailto:me@kevinqdam.com">Email me</a>
        <a
          class="button-secondary"
          href="https://www.linkedin.com/in/kevinqdam"
          target="_blank"
          rel="noreferrer noopener"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero-note">
        All opinions are my own and do not reflect those of any current or past
        employers.
      </p>
    </div>

    <figure class="home-portrait">
      <Image
        class="profile-image"
        alt="Kevin Dam"
        width={320}
        height={400}
        densities={[1, 2]}
        fit="cover"
        position="center"
        priority
        src={profileImage}
      />
    </figure>
  </section>

  <section class="home-writing" aria-labelledby="writing-heading">
    <div>
      <p class="eyebrow">Writing</p>
      <h2 id="writing-heading">Blog</h2>
    </div>
    <a class="text-link" href="/blog">View posts <span aria-hidden="true">→</span></a>
  </section>
</Layout>
