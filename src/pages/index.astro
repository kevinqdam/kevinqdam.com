---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/images/kevinqdam.png';
---

<Layout title="Kevin Dam | Software Engineer">
  <section class="hero" aria-labelledby="home-heading">
    <div>
      <p class="eyebrow">Software engineer</p>
      <h1 id="home-heading">Kevin Dam<span>.</span></h1>
      <p class="hero-intro">
        A passionate software engineer 🧑‍💻 who loves to solve problems by writing
        code.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="/experience">
          Explore experience <span aria-hidden="true">→</span>
        </a>
        <a class="button-secondary" href="/blog">Read the blog</a>
      </div>
      <p class="hero-note">
        All opinions are my own and do not reflect those of any current or past
        employers.
      </p>
    </div>
    <div class="profile-card">
      <Image
        class="profile-image"
        alt="Kevin Dam profile picture"
        width={176}
        height={176}
        densities={[1, 2]}
        fit="cover"
        priority
        src={profileImage}
      />
      <p class="profile-label">Kevin Q. Dam</p>
    </div>
  </section>

  <section class="home-grid" aria-label="Explore the site">
    <a class="feature-card" href="/experience">
      <div>
        <p class="eyebrow">Career & education</p>
        <h2>Experience</h2>
        <p>Browse roles, responsibilities, and education.</p>
      </div>
      <span class="feature-link">View experience <span aria-hidden="true">↗</span></span>
    </a>
    <a class="feature-card" href="/blog">
      <div>
        <p class="eyebrow">Writing</p>
        <h2>Blog</h2>
        <p>Notes on TypeScript, code review, and software engineering.</p>
      </div>
      <span class="feature-link">Read the latest <span aria-hidden="true">↗</span></span>
    </a>
  </section>
</Layout>
