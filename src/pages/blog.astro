---
import { DateTime } from 'luxon';
import readingTime from 'reading-time';
import removeMd from 'remove-markdown';
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostCard, { type BlogPostCardProps } from '../components/BlogPostCard';
import Pills, { type Pill } from '../components/Pills';
import Layout from '../layouts/Layout.astro';
import { resolveAuthorProfileImage } from '../lib/author-profile-image';

const getUniqueTags = (tags: CollectionEntry<'blog'>['data']['tags']): Pill[] => {
  const seen = new Set<string>();
  return tags.filter((tag) => {
    if (seen.has(tag.text)) {
      return false;
    }
    seen.add(tag.text);
    return true;
  });
};

const getPostSlug = (post: CollectionEntry<'blog'>) => post.id.replace(/\.(?:md|mdx)$/, '');

const toBlogPostCardProps = async (post: CollectionEntry<'blog'>): Promise<BlogPostCardProps> => {
  const { author, authorProfileImage, posted, title, preview, thumbnailImage, tags } = post.data;
  return {
    author,
    authorProfileImage: await resolveAuthorProfileImage(authorProfileImage),
    posted,
    title,
    preview,
    thumbnailImage,
    tags,
    slug: getPostSlug(post),
    estReadTimeMinutes: readingTime(removeMd(post.body ?? '')).text,
  };
};

const posts = await getCollection('blog');
posts.sort((a, b) => DateTime.fromISO(b.data.posted).toMillis() - DateTime.fromISO(a.data.posted).toMillis());
const tags = getUniqueTags(posts.flatMap((post) => post.data.tags)).sort((a, b) => a.text.localeCompare(b.text));
const blogPostCardProps = await Promise.all(posts.map(toBlogPostCardProps));
---

<Layout title="Blog | Kevin Dam" description="Writing by Kevin Dam.">
  <header class="page-header compact-page-header">
    <h1>Blog</h1>
  </header>

  <section aria-labelledby="posts-heading">
    {tags.length > 0 && (
      <nav class="blog-toolbar" aria-label="Browse posts by topic">
        <span>Topics</span>
        <Pills pills={tags.map((tag) => ({ ...tag, href: tag.href ?? `/blog/tag/${tag.text}` }))} />
      </nav>
    )}
    <h2 id="posts-heading" class="section-title">All posts</h2>
    <div class="post-list">
      {blogPostCardProps.map((props) => <BlogPostCard {...props} />)}
    </div>
  </section>
</Layout>
