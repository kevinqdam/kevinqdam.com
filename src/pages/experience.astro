---
import Anchor from '../components/Anchor.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Experience | Kevin Dam"
  description="Kevin Dam's professional experience and education."
>
  <div class="career-document">
    <header class="page-header">
      <h1>Experience</h1>
      <p class="page-lede">
        <Anchor href="https://www.linkedin.com/in/kevinqdam">View my LinkedIn profile</Anchor>
      </p>
    </header>

    <section class="section-block" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-title">Experience</h2>
      <div class="timeline">
        <article class="experience-item">
          <p class="experience-date">Dec 2024 — Present</p>
          <div>
            <h3>Meta</h3>
            <p class="experience-role">Software Engineer</p>
            <p class="experience-details">Full-time · San Francisco Bay Area</p>
            <h4 class="experience-project">Meta Business Agent</h4>
            <div class="achievement-list">
              <p>Previously, I worked on:</p>
              <p>
                AI-powered icebreaker pills for a third-party AI webchat plugin
                deployed to 100+ businesses and serving 1k+ conversations daily.{' '}
                <Anchor href="https://www.facebook.com/business/success/solgaard-bm-case-study">
                  Biz AI case study
                </Anchor>.
              </p>
              <p>
                Client infrastructure to optimize serving AI prompts for Facebook
                and Instagram feed ads at scale.
              </p>
              <p>Preview features for Ads Manager.</p>
              <p>
                Currently, I build product features for enterprises using Meta
                Business Agent in WhatsApp.{' '}
                <Anchor href="https://whatsappbusiness.com/blog/introducing-meta-business-agent-ai/">
                  Introducing Meta Business Agent on WhatsApp
                </Anchor>.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies & skills:</strong> Hack, JavaScript, PHP,
              full-stack development, web engineering, React.js
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Mar 2024 — Oct 2024</p>
          <div>
            <h3>SpaceX</h3>
            <p class="experience-role">Software Engineer</p>
            <p class="experience-details">Full-time · Los Angeles Metropolitan Area · On-site</p>
            <h4 class="experience-project">Starlink Fulfillment</h4>
            <div class="achievement-list">
              <p>
                Maintained an event-driven system operating workloads that
                supported Starlink order fulfillment and outbound logistics. The
                system processed approximately 10,000+ orders daily.
              </p>
              <p>
                Collaborated with stakeholders and logistics carriers to improve
                systems and help new Starlink customers receive satellite-internet
                service conveniently and quickly.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies:</strong> C#, ASP.NET, Microsoft Azure,
              Terraform, TypeScript, Angular, PostgreSQL, Apache Kafka,
              Kubernetes, Microsoft SQL Server, .NET
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Jun 2022 — Mar 2024</p>
          <div>
            <h3>Amazon</h3>
            <p class="experience-role">Software Development Engineer</p>
            <div class="achievement-list">
              <p>
                <strong>New Hire IT Onboarding.</strong> Developed, maintained,
                and operated a suite of self-service onboarding wizards serving
                hundreds of new Amazon employees every week.
              </p>
              <p>
                <strong>IT Workflow Wizard.</strong> Designed and developed an
                interface that consumed platform definitions from process
                engineers and rendered guided experiences serving all Amazon
                employees for any IT need, such as setting up internal email on a
                mobile device.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies:</strong> TypeScript, Node.js, React, AWS
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Mar 2021 — May 2022</p>
          <div>
            <h3>ServiceNow</h3>
            <p class="experience-role">Software Engineer</p>
            <div class="achievement-list">
              <p>
                <strong>Core Platform.</strong> Delivered{' '}
                <Anchor href="https://docs.servicenow.com/en-US/bundle/tokyo-application-development/page/script/JavaScript-engine-upgrade/concept/c_JS_engine_upgrade.html">
                  ECMAScript 2021
                </Anchor>{' '}
                in the Tokyo release, bringing modern scripting features to the
                ServiceNow ecosystem for all{' '}
                <Anchor href="https://www.servicenow.com/customers.html">
                  ServiceNow customers
                </Anchor>{' '}
                who upgraded.
              </p>
              <p>
                <strong>Now User Experience Framework.</strong> Developed
                features for{' '}
                <Anchor href="https://docs.servicenow.com/bundle/sandiego-platform-user-interface/page/get-started/servicenow-overview/concept/next-experience-ui.html">
                  Next Experience UI (Polaris)
                </Anchor>{' '}
                in the San Diego release, delivering the long-awaited project
                after its delay for two releases.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies:</strong> Java, JavaScript, Now Experience Framework
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Aug 2019 — Feb 2021</p>
          <div>
            <h3>Fast Enterprises</h3>
            <p class="experience-role">Implementation Consultant</p>
            <div class="achievement-list">
              <p>
                <strong>MNDRIVE.</strong> Developed vehicle titling and
                registration interfaces for the{' '}
                <Anchor href="https://www.startribune.com/smooth-start-seen-this-week-for-mndrive-the-state-s-new-vehicle-and-license-registration-system/573118001/">
                  successful release
                </Anchor>{' '}
                serving all Minnesota motorists.
              </p>
              <p>
                <strong>NMVTIS.</strong> Developed an interface servicing
                hundreds of daily requests to protect Minnesota motorists from
                title fraud.
              </p>
              <p>
                <strong>Registration renewal notices.</strong> Developed the
                interface that mails notices to ~300,0000 motorists monthly.
              </p>
              <p>
                <strong>Mail-in vehicle registration renewals.</strong> Developed
                the processing interface servicing tens of thousands of
                registrations monthly.
              </p>
              <p>
                <strong>Ticketing.</strong> Developed the interface servicing
                hundreds of license plate queries weekly.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies:</strong> Microsoft SQL Server, Visual Basic, .NET
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Oct 2018 — Jun 2019</p>
          <div>
            <h3>PSC Biotech</h3>
            <p class="experience-role">Implementation Specialist</p>
            <div class="achievement-list">
              <p>
                Implemented{' '}
                <Anchor href="https://pscsoftware.com/software/ace/">
                  FDA-compliant enterprise software solutions
                </Anchor>{' '}
                for pharmaceutical companies in collaboration with product,
                project, engineering, and operations teams, ensuring each solution
                was flexible and met all stakeholder needs.
              </p>
            </div>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Jul 2018 — Oct 2018</p>
          <div>
            <h3>Santa Clara County Registrar of Voters</h3>
            <p class="experience-role">Student Intern III</p>
            <div class="achievement-list">
              <p>
                Maintained{' '}
                <Anchor href="https://sccvote.sccgov.org/register-vote/precinct-maps">
                  precinct boundaries
                </Anchor>{' '}
                so all Santa Clara County voters could vote safely and efficiently
                in transparent, honest elections.
              </p>
            </div>
            <p class="experience-technologies"><strong>Technology:</strong> ArcGIS</p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Aug 2016 — Dec 2017</p>
          <div>
            <h3>UC San Diego Teaching + Learning Commons</h3>
            <p class="experience-role">SI Leader (Peer Tutor for Math)</p>
            <div class="achievement-list">
              <p>
                Led{' '}
                <Anchor href="https://aah.ucsd.edu/supplemental-instruction/index.html">
                  Supplemental Instruction
                </Anchor>{' '}
                for calculus and linear algebra; participants earned a half
                letter grade higher than students who did not participate.
              </p>
            </div>
            <p class="experience-technologies">
              <strong>Technologies:</strong> MATLAB, LaTeX
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="section-block" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-title">Education</h2>
      <article class="education-entry">
        <div>
          <h3>University of California San Diego</h3>
          <p>B.S. Bioengineering, Minor in Organic Chemistry</p>
        </div>
        <p>
          Boyer Chancellor's scholarship recipient. Graduated <em>magna cum laude</em>,
          received provost honors every academic quarter, and was a two-year member
          and one-year co-captain of the UCSD Dragon Boat team. Member of Tau Beta Pi
          and Phi Beta Kappa.
        </p>
      </article>
    </section>
  </div>
</Layout>
