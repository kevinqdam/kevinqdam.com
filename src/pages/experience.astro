---
import Anchor from '../components/Anchor.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Experience | Kevin Dam"
  description="Kevin Dam's professional experience, selected skills, and education."
>
  <div class="career-document">
    <header class="page-header">
      <p class="eyebrow">Career</p>
      <h1>Experience</h1>
      <p class="page-lede">
        LinkedIn is the complete and most current professional record. View my{' '}
        <Anchor href="https://www.linkedin.com/in/kevinqdam">LinkedIn profile</Anchor>.
      </p>
    </header>

    <section class="section-block" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-title">Chronology</h2>
      <div class="timeline">
        <article class="experience-item">
          <p class="experience-date">Current</p>
          <div>
            <h3>SpaceX</h3>
            <p class="experience-role">Software Engineer</p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Jun 2022 — Mar 2024</p>
          <div>
            <h3>Amazon</h3>
            <p class="experience-role">Software Development Engineer</p>
            <ul class="achievement-list">
              <li>
                <strong>New Hire IT Onboarding.</strong> Developed, maintained,
                and operated self-service wizards serving hundreds of new Amazon
                employees every week.
              </li>
              <li>
                <strong>IT Workflow Wizard.</strong> Designed and developed an
                interface that rendered platform definitions as guided IT
                experiences for Amazon employees.
              </li>
            </ul>
            <p class="experience-technologies">
              <strong>Technologies:</strong> TypeScript, Node.js, React, AWS
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Mar 2021 — May 2022</p>
          <div>
            <h3>ServiceNow</h3>
            <p class="experience-role">Software Engineer</p>
            <ul class="achievement-list">
              <li>
                <strong>Core Platform.</strong> Delivered{' '}
                <Anchor href="https://docs.servicenow.com/en-US/bundle/tokyo-application-development/page/script/JavaScript-engine-upgrade/concept/c_JS_engine_upgrade.html">
                  ECMAScript 2021
                </Anchor>{' '}
                in the Tokyo release for customers who upgraded.
              </li>
              <li>
                <strong>Now User Experience Framework.</strong> Developed
                features for{' '}
                <Anchor href="https://docs.servicenow.com/bundle/sandiego-platform-user-interface/page/get-started/servicenow-overview/concept/next-experience-ui.html">
                  Next Experience UI (Polaris)
                </Anchor>{' '}
                in the San Diego release.
              </li>
            </ul>
            <p class="experience-technologies">
              <strong>Technologies:</strong> Java, JavaScript, Now Experience Framework
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Aug 2019 — Feb 2021</p>
          <div>
            <h3>Fast Enterprises</h3>
            <p class="experience-role">Implementation Consultant</p>
            <ul class="achievement-list">
              <li>
                <strong>MNDRIVE.</strong> Developed vehicle titling and
                registration interfaces for the{' '}
                <Anchor href="https://www.startribune.com/smooth-start-seen-this-week-for-mndrive-the-state-s-new-vehicle-and-license-registration-system/573118001/">
                  successful release
                </Anchor>{' '}
                serving Minnesota motorists.
              </li>
              <li>
                <strong>NMVTIS.</strong> Developed an interface servicing
                hundreds of daily requests to protect motorists from title fraud.
              </li>
              <li>
                <strong>Registration renewal notices.</strong> Developed the
                interface that mails notices to ~300,0000 motorists monthly.
              </li>
            </ul>
            <p class="experience-technologies">
              <strong>Technologies:</strong> Microsoft SQL Server, Visual Basic, .NET
            </p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Oct 2018 — Jun 2019</p>
          <div>
            <h3>PSC Biotech</h3>
            <p class="experience-role">Implementation Specialist</p>
            <ul class="achievement-list">
              <li>
                Implemented{' '}
                <Anchor href="https://pscsoftware.com/software/ace/">
                  FDA-compliant enterprise software solutions
                </Anchor>{' '}
                for pharmaceutical companies in collaboration with product,
                project, engineering, and operations teams.
              </li>
            </ul>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Jul 2018 — Oct 2018</p>
          <div>
            <h3>Santa Clara County Registrar of Voters</h3>
            <p class="experience-role">Student Intern III</p>
            <ul class="achievement-list">
              <li>
                Maintained{' '}
                <Anchor href="https://sccvote.sccgov.org/register-vote/precinct-maps">
                  precinct boundaries
                </Anchor>{' '}
                to support safe, efficient, and transparent elections.
              </li>
            </ul>
            <p class="experience-technologies"><strong>Technology:</strong> ArcGIS</p>
          </div>
        </article>

        <article class="experience-item">
          <p class="experience-date">Aug 2016 — Dec 2017</p>
          <div>
            <h3>UC San Diego Teaching + Learning Commons</h3>
            <p class="experience-role">SI Leader (Peer Tutor for Math)</p>
            <ul class="achievement-list">
              <li>
                Led{' '}
                <Anchor href="https://aah.ucsd.edu/supplemental-instruction/index.html">
                  Supplemental Instruction
                </Anchor>{' '}
                for calculus and linear algebra; participants earned a half
                letter grade higher than students who did not participate.
              </li>
            </ul>
            <p class="experience-technologies">
              <strong>Technologies:</strong> MATLAB, LaTeX
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="section-block skills-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-title">Selected skills</h2>
      <dl class="skills-index">
        <div>
          <dt>Languages</dt>
          <dd>TypeScript, JavaScript, Java, Visual Basic</dd>
        </div>
        <div>
          <dt>Frontend</dt>
          <dd>React, Now Experience Framework</dd>
        </div>
        <div>
          <dt>Backend & data</dt>
          <dd>Node.js, .NET, Microsoft SQL Server</dd>
        </div>
        <div>
          <dt>Cloud & tools</dt>
          <dd>AWS, ArcGIS, MATLAB, LaTeX</dd>
        </div>
      </dl>
    </section>

    <section class="section-block education-section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-title">Education</h2>
      <article class="education-entry">
        <div>
          <h3>University of California San Diego</h3>
          <p>B.S. Bioengineering, Minor in Organic Chemistry</p>
        </div>
        <p>
          Boyer Chancellor's scholarship recipient. Graduated <em>magna cum laude</em>,
          received provost honors every academic quarter, and was a two-year member
          and one-year co-captain of the UCSD Dragon Boat team. Member of Tau Beta Pi
          and Phi Beta Kappa.
        </p>
      </article>
    </section>
  </div>
</Layout>
