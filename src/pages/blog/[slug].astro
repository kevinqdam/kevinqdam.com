---
import { DateTime } from 'luxon';
import readingTime from 'reading-time';
import removeMd from 'remove-markdown';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Pills from '../../components/Pills';
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar';
import profileImage from '../../assets/images/kevinqdam.png';

export const getStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(?:md|mdx)$/, '') },
    props: { post },
  }));
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { author, authorProfileImage, title, tags, posted, preview } = post.data;
const postedDateTime = DateTime.fromISO(posted);
const estReadTimeMinutes = readingTime(removeMd(post.body ?? '')).text;
const { Content } = await render(post);
const optimizedProfileImages = new Map<string, typeof profileImage>([
  ['/images/kevinqdam.png', profileImage],
]);
const optimizedAuthorProfileImage = authorProfileImage
  ? optimizedProfileImages.get(authorProfileImage.src)
  : undefined;
---

<Layout title={`${title} | Kevin Dam`} description={preview}>
  <NavBar client:load activePath="/blog" />
  <a class="back-link" href="/blog">← All posts</a>
  <header class="post-header">
    <Pills pills={tags} />
    <h1>{title}</h1>
    <div class="post-meta">
      {authorProfileImage && (
        optimizedAuthorProfileImage ? (
          <Image
            class="author-image"
            alt={authorProfileImage.alt}
            width={52}
            height={52}
            densities={[1, 2]}
            fit="cover"
            src={optimizedAuthorProfileImage}
          />
        ) : (
          <img
            class="author-image"
            alt={authorProfileImage.alt}
            width="52"
            height="52"
            loading="lazy"
            decoding="async"
            src={authorProfileImage.src}
          />
        )
      )}
      <div>
        <div class="post-author">{author}</div>
        <div>
          <time datetime={posted}>{postedDateTime.toFormat('MMM d, yyyy')}</time>
          <span> · {estReadTimeMinutes}</span>
        </div>
      </div>
    </div>
  </header>
  <article class="prose dark:prose-invert post-content">
    <Content />
  </article>
</Layout>
