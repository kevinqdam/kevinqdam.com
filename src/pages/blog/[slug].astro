---
import { DateTime } from 'luxon';
import readingTime from 'reading-time';
import removeMd from 'remove-markdown';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Pills from '../../components/Pills';
import Layout from '../../layouts/Layout.astro';
import { resolveAuthorProfileImage } from '../../lib/author-profile-image';

export const getStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(?:md|mdx)$/, '') },
    props: { post },
  }));
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { author, authorProfileImage, title, tags, posted, preview } = post.data;
const postedDateTime = DateTime.fromISO(posted);
const estReadTimeMinutes = readingTime(removeMd(post.body ?? '')).text;
const { Content } = await render(post);
const resolvedAuthorProfileImage = await resolveAuthorProfileImage(authorProfileImage);
---

<Layout title={`${title} | Kevin Dam`} description={preview}>
  <a class="back-link" href="/blog">← All posts</a>
  <header class="post-header">
    <Pills pills={tags} />
    <h1>{title}</h1>
    <div class="post-meta">
      {resolvedAuthorProfileImage && (
        <img
          class="author-image"
          alt={resolvedAuthorProfileImage.alt}
          width="52"
          height="52"
          loading="lazy"
          decoding="async"
          src={resolvedAuthorProfileImage.src}
        />
      )}
      <div>
        <div class="post-author">{author}</div>
        <div>
          <time datetime={posted}>{postedDateTime.toFormat('MMM d, yyyy')}</time>
          <span> · {estReadTimeMinutes}</span>
        </div>
      </div>
    </div>
  </header>
  <article class="prose dark:prose-invert post-content">
    <Content />
  </article>
</Layout>
