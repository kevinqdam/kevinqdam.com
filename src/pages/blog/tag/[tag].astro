---
import { DateTime } from 'luxon';
import readingTime from 'reading-time';
import removeMd from 'remove-markdown';
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostCard, { type BlogPostCardProps } from '../../../components/BlogPostCard';
import Pills, { type Pill } from '../../../components/Pills';
import Layout from '../../../layouts/Layout.astro';
import { resolveAuthorProfileImage } from '../../../lib/author-profile-image';

export const getStaticPaths = async () => {
  const posts = await getCollection('blog');
  const uniqueTagTexts = new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.text)));

  return [...uniqueTagTexts].map((tag) => ({
    params: { tag },
  }));
};

const { tag: currentTag } = Astro.params;

const getUniqueTags = (tags: CollectionEntry<'blog'>['data']['tags']): Pill[] => {
  const seen = new Set<string>();
  return tags.filter((tag) => {
    if (seen.has(tag.text)) {
      return false;
    }
    seen.add(tag.text);
    return true;
  }).map((tag) => tag.text === currentTag
    ? { ...tag, invertColor: true, href: '/blog' }
    : { ...tag, href: tag.href ?? `/blog/tag/${tag.text}` });
};

const getPostSlug = (post: CollectionEntry<'blog'>) => post.id.replace(/\.(?:md|mdx)$/, '');

const toBlogPostCardProps = async (post: CollectionEntry<'blog'>): Promise<BlogPostCardProps> => {
  const { author, authorProfileImage, posted, title, preview, thumbnailImage, tags } = post.data;
  return {
    author,
    authorProfileImage: await resolveAuthorProfileImage(authorProfileImage),
    posted,
    title,
    preview,
    thumbnailImage,
    tags: tags
      .map((tag) => tag.text === currentTag
        ? { ...tag, invertColor: true, href: '/blog' }
        : { ...tag, href: tag.href ?? `/blog/tag/${tag.text}` })
      .sort((a, b) => a.text.localeCompare(b.text)),
    slug: getPostSlug(post),
    estReadTimeMinutes: readingTime(removeMd(post.body ?? '')).text,
  };
};

const posts = await getCollection('blog');
posts.sort((a, b) => DateTime.fromISO(b.data.posted).toMillis() - DateTime.fromISO(a.data.posted).toMillis());
const tags = getUniqueTags(posts.flatMap((post) => post.data.tags)).sort((a, b) => a.text.localeCompare(b.text));
const blogPostCardProps = await Promise.all(
  posts
    .filter((post) => post.data.tags.some((tag) => tag.text === currentTag))
    .map(toBlogPostCardProps)
);
---

<Layout title={`Blog · ${currentTag} | Kevin Dam`}>
  <header class="page-header">
    <p class="eyebrow">Writing · topic</p>
    <h1>{currentTag}</h1>
    <p class="page-lede">Posts filed under this topic.</p>
  </header>

  <section aria-labelledby="tag-posts-heading">
    <div class="blog-toolbar">
      <h2>Browse by topic</h2>
      <Pills pills={tags} />
    </div>
    <div class="section-heading">
      <div>
        <p class="eyebrow">Archive</p>
        <h2 id="tag-posts-heading">Posts tagged {currentTag}</h2>
      </div>
    </div>
    <div class="post-list">
      {blogPostCardProps.map((props) => <BlogPostCard {...props} />)}
    </div>
  </section>
</Layout>
